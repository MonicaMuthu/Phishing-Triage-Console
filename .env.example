# Copy this file to .env and set real values locally.
# Never commit your real .env file.

# Start with: uvicorn app.main:app --reload --port 8010

VIRUSTOTAL_API_KEY=your_virustotal_api_key_here
ABUSEIPDB_API_KEY=your_abuseipdb_api_key_here

# Required Phase 6 mailbox ingestion settings
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your_mailbox@gmail.com
IMAP_FOLDER=INBOX

# Gmail OAuth2 uses gmail_client_secret.json (downloaded from Google Cloud),
# not environment variables. Do not put CLIENT_ID/CLIENT_SECRET here.